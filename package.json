{
  "name": "@lilit/design-system",
  "version": "0.1.0",
  "description": "Design system components and tokens, built from the Genesis Figma kit",
  "type": "module",
  "private": true,
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-typography.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static --disable-telemetry",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.1",
    "storybook": "^10.6.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
